@model AspNetCore.Validation.StudentsDb.Models.Book
@{
    ViewData["Title"] = "Видалення книги";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-danger mb-4">Видалення книги</h1>

<div class="alert alert-danger" role="alert">
    <h4 class="alert-heading">Увага!</h4>
    <p>Ви дійсно бажаєте безповоротно видалити цю книгу з бази даних?</p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Author)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Author)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Year)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Year)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Підтвердити видалення
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Повернутися до списку</a>
</form>