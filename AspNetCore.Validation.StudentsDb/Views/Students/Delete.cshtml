@model AspNetCore.Validation.StudentsDb.Models.Student
@{
    ViewData["Title"] = "Видалення студента";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-danger mb-4">Видалення студента</h1>

<div class="alert alert-danger shadow-sm" role="alert">
    <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Увага!</h4>
    <p>Ви дійсно бажаєте безповоротно видалити дані цього студента з бази?</p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Surname)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Surname)</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Age)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Age)</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.GPA)</dt>
            <dd class="col-sm-9">
                <span class="badge bg-info text-dark">@Html.DisplayFor(model => model.GPA)</span>
            </dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
        </dl>
    </div>
</div>
    
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Підтвердити видалення
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Повернутися до списку</a>
</form>