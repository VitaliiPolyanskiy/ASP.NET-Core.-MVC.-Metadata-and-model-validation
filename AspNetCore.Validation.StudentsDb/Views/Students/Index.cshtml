@model IEnumerable<AspNetCore.Validation.StudentsDb.Models.Student>
@{
    ViewData["Title"] = "Список студентів";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">Список студентів</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill"></i> Додати студента
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Surname)</th>
                    <th>@Html.DisplayNameFor(model => model.Age)</th>
                    <th>@Html.DisplayNameFor(model => model.GPA)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="align-middle">@Html.DisplayFor(modelItem => item.Name)</td>
                    <td class="align-middle">@Html.DisplayFor(modelItem => item.Surname)</td>
                    <td class="align-middle">@Html.DisplayFor(modelItem => item.Age)</td>
                    <td class="align-middle">
                        <span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.GPA)</span>
                    </td>
                    <td class="align-middle">@Html.DisplayFor(modelItem => item.Email)</td>
                    <td class="text-end align-middle">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>