@model AspNetCore.Validation.StudentsDb.Models.Student
@{
    ViewData["Title"] = "Додавання студента";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="mb-4">Додавання студента</h1>

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Surname" class="form-label fw-bold"></label>
                    <input asp-for="Surname" class="form-control" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Age" class="form-label fw-bold"></label>
                    <input asp-for="Age" class="form-control" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GPA" class="form-label fw-bold"></label>
                    <input asp-for="GPA" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="GPA" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Додати
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}